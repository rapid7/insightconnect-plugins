import os
import json
from sys import argv

Name = "RelayShield"
Vendor = "relayshield"
Version = "1.0.0"
Description = "RelayShield detects identity and crypto-asset attack signals while an attack is still forming -- credential breaches, SIM-swap fraud, lookalike/typosquat domains, and wallet/token risk -- rather than after an account has already been taken over"


def main():
    if 'http' in argv:
        if os.environ.get("GUNICORN_CONFIG_FILE"):
            with open(os.environ.get("GUNICORN_CONFIG_FILE")) as gf:
                gunicorn_cfg = json.load(gf)
                if gunicorn_cfg.get("worker_class", "sync") == "gevent":
                    from gevent import monkey
                    monkey.patch_all()
        elif 'gevent' in argv:
            from gevent import monkey
            monkey.patch_all()

    import insightconnect_plugin_runtime
    from icon_relayshield import connection, actions, triggers, tasks

    class ICONRelayshield(insightconnect_plugin_runtime.Plugin):
        def __init__(self):
            super(self.__class__, self).__init__(
                name=Name,
                vendor=Vendor,
                version=Version,
                description=Description,
                connection=connection.Connection()
            )
            self.add_action(actions.CheckBreach())
        
            self.add_action(actions.CheckSimSwap())
        
            self.add_action(actions.CheckDomain())
        
            self.add_action(actions.CheckCryptoIntel())
        

    """Run plugin"""
    cli = insightconnect_plugin_runtime.CLI(ICONRelayshield())
    cli.run()


if __name__ == "__main__":
    main()
